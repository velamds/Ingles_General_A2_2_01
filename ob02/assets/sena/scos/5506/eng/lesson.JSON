{"_data": [{"contents": [{"content": "John Comes Home for a Visit", "type": "lesson_name"}, {"content": "Long Time, No See", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about people's jobs and places of work in communicative situations.", "type": "primary"}, {"content": "Placeholder", "type": "secondary_1"}, {"content": "Placeholder", "type": "secondary_2"}, {"content": "", "type": "secondary_3"}, {"content": "", "type": "secondary_4"}, {"content": "", "type": "secondary_5"}, {"content": "", "type": "secondary_6"}, {"content": "", "type": "secondary_7"}, {"content": "", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le01ob02re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Describing People", "type": "heading"}, {"content": "You use adjectives to describe people.<br/><br/>You can also use nouns to say what a person has, like a beard.", "type": "describer"}, {"content": "The adjective can be placed: <br/><br/> -  Before the person<br/>-  After the verb <span class=\"italic\">to be</span> or <span class=\"italic\">to have</span><br/>-  After an expression like \u201cwith ... \u201d", "type": "text"}, {"content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adjectives\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Nouns\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"short, tall\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"man, woman\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"blonde, brunette\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"man, woman\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"thin, heavyset\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"man, woman\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"brown, blue, green\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"eyes\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"blond, brown, black, gray\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"hair\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"long, short\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"beard\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "The tall woman is in the office.", "type": "example"}, {"content": "He's a short man.", "type": "example"}, {"content": "He's a heavyset man with a beard. ", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "The Simple Past Tense", "type": "heading"}, {"content": " You use the Simple Past tense to talk about events that are finished.", "type": "describer"}, {"content": "Simple Past tense verbs can be regular or irregular. <br/> Regular verbs end in <span class=\"italic\">-ed</span> or <span class=\"italic\">-ied</span>.<br/> Irregular verbs change in different ways.<br/> For questions in the past, you use the auxiliary <span class=\"italic\">did</span> followed by the verb in the base form, like <span class=\"italic\">Did you ask ... ?</span> <br/> <span class=\"italic\">Did</span> is the past form of <span class=\"italic\">to do</span>.", "type": "text"}, {"content": "{\"rows\":9,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Simple Past Tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to ask\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"asked\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to copy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"copied\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to surround\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"surrounded\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to protect\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"protected\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to be\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was, were\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to make\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"made\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to think\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"thought\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "Last week, I had a problem with a colleague.", "type": "example"}, {"content": "He asked me to write a report. ", "type": "example"}, {"content": "I didn't get any help from anyone, so I just made something up.  ", "type": "example"}, {"content": "He didn't like it very much.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "colleague", "type": "name"}, {"content": "a person you work with", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Last week I had a problem with a colleague. ", "type": "example"}, {"content": "engenn5le01ob02aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use when you describe people or talk about work.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "heavyset", "type": "name"}, {"content": "a person who has a large size around the waist", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He's a short, heavyset man with a beard. ", "type": "example"}, {"content": "engenn5le01ob02aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "beard", "type": "name"}, {"content": "hair grown on the chin", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: My colleague has a beard. ", "type": "example"}, {"content": "engenn5le01ob02aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to cause ", "type": "name"}, {"content": "to result in some change", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I caused another problem at work.", "type": "example"}, {"content": "engenn5le01ob02aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "office", "type": "name"}, {"content": " the place where a person works", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There's a problem in the office.", "type": "example"}, {"content": "engenn5le01ob02aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "document", "type": "name"}, {"content": "information printed on paper or on an electronic file ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: She asked me to revise a document.", "type": "example"}, {"content": "engenn5le01ob02aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to make up", "type": "name"}, {"content": " to invent ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I didn't know the answer, so I just made something up. ", "type": "example"}, {"content": "engenn5le01ob02aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "pet peeve", "type": "name"}, {"content": "something that bothers or annoys you", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: That's my pet peeve.", "type": "example"}, {"content": "engenn5le01ob02aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Think of your pet peeves (things that happen that you don't like) at work.", "type": "text"}, {"content": "Write them on a list.", "type": "text"}, {"content": "Ask 3 other people about their pet peeves. Add their ideas to the list.", "type": "text"}, {"content": "Select the top 5 pet peeves shared by people.", "type": "text"}, {"content": "Present your list to your classmates.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a list of my pet peeves.", "type": "text"}, {"content": "I talk to 3 other people about pet peeves.", "type": "text"}, {"content": "I write a list of 5 top pet peeves.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"contents": [{}], "template_override": 1, "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le01ob02re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le01ob02re2img05.jpg", "time": "100", "id": 1, "text": "<span class =\"strong\">John</span>:  Long time no see! How's your work going?<br />\n<span class =\"strong\">Peter</span>:  It's a bit stressful. <br />\n<span class =\"strong\">John</span>: Why?"}, {"image": "engenn5le01ob02re2img01.jpg", "time": "5500", "id": 2, "text": "<span class =\"strong\">Peter</span>: Well, last week I had a problem with a colleague, Ted. He's a short, heavyset man with a beard. He asked me to write a report. I didn't get any help from anyone, so I just made something up. He didn't like it very much.<br />\n<span class =\"strong\">John</span>: Oh, that's too bad."}, {"image": "engenn5le01ob02re2img06.jpg", "time": "23500", "id": 3, "text": "<span class =\"strong\">Peter</span>: Then last week, I caused another problem in the office. I'm sharing a workspace with this woman, Amanda. <br />\n<span class =\"strong\">John</span>:  Amanda? Is she pretty?"}, {"image": "engenn5le01ob02re2img02.jpg", "time": "33000", "id": 4, "text": "<span class =\"strong\">Peter</span>:  Yes. She has long blonde hair and blue eyes. Anyways, she asked me to revise a document, but I lost it, so she had to do it again."}, {"image": "engenn5le01ob02re2img07.jpg", "time": "43000", "id": 5, "text": "<span class =\"strong\">John</span>: Oh, Peter!  That's my pet peeve!"}], "audiosrc": "engenn5le01ob02re2aud01", "coverimg": "engenn5le01ob02re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "questions": [], "type": "WLC", "_data": [{"contents": [{"content": " I can describe people.", "type": "Learning Outcomes"}, {"content": " I can talk about jobs and work.", "type": "Learning Outcomes"}, {"content": " I can talk or report about things, actions and events.", "type": "Learning Outcomes"}, {"content": " What are some problems that happen at work? ", "type": "Free Header Item"}, {"content": " Did these things happen to you? When?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner: ", "type": "free_header_text"}, {"content": "What happened last week?", "type": "free_type_text_area"}], "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "questions": [{"_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}]}], "type": "STI", "_data": [{"contents": [{"content": " Peter and John are talking about work. What i