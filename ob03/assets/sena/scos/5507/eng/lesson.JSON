{"_data": [{"contents": [{"content": "John Comes Home for a Visit", "type": "lesson_name"}, {"content": "What's New at Work?", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_1"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_4"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le01ob03re1img01.jpg", "type": "background_image"}, {"contents": [{"content": " Talking About Work", "type": "heading"}, {"content": " Here are some words you use to talk about work.", "type": "describer"}, {"content": "Responsibilities:<br/><br/> communications: oral and written messages from a company or institution<br/> marketing: promoting a business in different ways<br/> design: how something looks<br/> event planning: the processing of organizing large meetings<br/><br/>  Other work-related words:<br/><br/>  real-world experience:  things you learn and skills you develop at work, not school<br/> meeting: a group of people talking and making decisions together<br/> convention: a large meeting of many people<br/> convention center: a large building where conventions are organized<br/> brochure: a written document about a business<br/> professional: a person who is paid to do an activity<br/> amateur: a person who is not a professional <br/>", "type": "text"}, {"content": "I'm getting some real-world experience in communications, marketing and design.  ", "type": "example"}, {"content": "I am responsible for event planning.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "real-world", "type": "name"}, {"content": "typical of things that happen", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I'm getting some real-world experience at my job. ", "type": "example"}, {"content": "engenn5le01ob03aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use to talk about work and business meetings.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "communications", "type": "name"}, {"content": "formal messages from a company or institution, in writing or through the media", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I work in communications, marketing and design.", "type": "example"}, {"content": "engenn5le01ob03aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "sausage", "type": "name"}, {"content": "different types of meat tightly wrapped", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I organized a meeting of German sausage makers. ", "type": "example"}, {"content": "engenn5le01ob03aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "amateur", "type": "name"}, {"content": "describes a person who does an activity for pleasure, not as a job", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Last week there was a convention for amateur astronomers.", "type": "example"}, {"content": "engenn5le01ob03aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "professional", "type": "name"}, {"content": "describes a person who is paid money to do an activity", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I organized a meeting of professional German sausage makers. ", "type": "example"}, {"content": "engenn5le01ob03aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "astronomer", "type": "name"}, {"content": "a person who studies outer space", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm interested in space, so I want to be an astronomer.", "type": "example"}, {"content": "engenn5le01ob03aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to misspell", "type": "name"}, {"content": "to write something incorrectly", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I misspelled the word <span class=\"italic\">astronomer</span>.", "type": "example"}, {"content": "engenn5le01ob03aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Make a list of 10 jobs. Write each job on a separate paper.", "type": "text"}, {"content": "For each job, write 1 responsibility. Write each responsibility on a separate paper.", "type": "text"}, {"content": "Place the papers face down so you can't see the words.", "type": "text"}, {"content": "Turn one paper over to see the word.", "type": "text"}, {"content": "Turn another paper over. If they are a match, you take the words. If they are not a match, you place them face down again.", "type": "text"}, {"content": "Continue until all the papers are taken.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I think of jobs and responsibilities.", "type": "text"}, {"content": "I make a memory game.", "type": "text"}, {"content": "I play the memory game with a partner.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"contents": [{}], "template_override": 1, "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le01ob03re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le01ob03re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">John</span>: What's new at work? <br>\n<span class=\"strong\">Peter</span>:  I'm still an intern at MechaTech.<br>\n<span class=\"strong\">John</span>: Do you like it?<br>\n<span class=\"strong\">Peter</span>:   Yes, I do. I'm getting some real-world experience in communications, marketing and design. I am responsible for event planning.<br>\n<span class=\"strong\">John</span>: What kind of events do you plan?<br>"}, {"image": "engenn5le01ob03re2img01.jpg", "time": "16000", "id": 2, "text": "<span class=\"strong\">Peter</span>: I organized a meeting of professional German sausage makers. They talked about spices a lot. <br>\n<span class=\"strong\">John</span>: That's cool. When was the event?<br>\n<span class=\"strong\">Peter</span>: It was last week.  I didn't understand anything. The week before that, there was a convention for amateur astronomers. I prepared the marketing brochure.<br>"}, {"image": "engenn5le01ob03re2img05.jpg", "time": "35500", "id": 3, "text": "<span class=\"strong\">John</span>: Wow, that's really cool. How did it go?<br>\n<span class=\"strong\">Peter</span>:  The brochure was good, except that I misspelled the word \u201castronomer\u201d. I spelled it \u201car\u201d instead of \u201cer\u201d.<br>\n<span class=\"strong\">John</span>: Oh, Peter! <br>"}], "audiosrc": "engenn5le01ob03re2aud01", "coverimg": "engenn5le01ob03re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "questions": [], "type": "WLC", "_data": [{"contents": [{"content": " I can talk about jobs and work. ", "type": "Learning Outcomes"}, {"content": " I can ask questions using words like what, when, where. ", "type": "Learning Outcomes"}, {"content": " I can talk or report about things, actions and events. ", "type": "Learning Outcomes"}, {"content": " What's new at work? ", "type": "Free Header Item"}, {"content": " Do you like your work? Why or why not?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner: ", "type": "free_header_text"}, {"content": "What's new with you?", "type": "free_type_text_area"}], "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "questions": [{"_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0, "responses": 